// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Accordion {
  id    Int               @id @default(autoincrement())
  slug  String            @unique
  items AccordionItem[]
}

model AccordionItem {
  id          Int         @id @default(autoincrement())
  label       String
  content     String
  icon        String
  order       Int
  accordionId Int
  accordion   Accordion   @relation(fields: [accordionId], references: [id])
}


model Carousel {
  id    Int               @id @default(autoincrement())
  slug  String            @unique
  items CarouselItem[]
}

model CarouselItem {
  id          Int              @id @default(autoincrement())
  quote       String
  name        String
  createDate  DateTime         @default(now())
  order       Int
  carouselId  Int
  carousel    Carousel         @relation(fields: [carouselId], references: [id])
}

model LogoRow {
  id          Int             @id @default(autoincrement())
  slug        String          @unique
  reverse     Boolean
  items       Logo[]
}

model Logo {
  id          Int             @id @default(autoincrement())
  src         String
  alt         String
  logoRowId      Int
  logoRow        LogoRow       @relation(fields: [logoRowId], references: [id])
}